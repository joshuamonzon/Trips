<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>Japan 50 · Ideas from chat</name><Style id="idea"><IconStyle><color>ff00d7ff</color><Icon><href>https://maps.google.com/mapfiles/kml/paddle/ylw-stars.png</href></Icon></IconStyle></Style>
<Folder><name>Tokyo — Food &amp; Drink</name>
<Placemark><styleUrl>#idea</styleUrl><name>Tsukiji Food Tour w/ Ali (meet point)</name><description>Airbnb Experience 6919404 — ~2hr, from $32/pp, food not included, bring cash. Book 7 AM slot early in trip. Itinerary already hits Tsukiji (Tokyo #5). https://www.airbnb.com/experiences/6919404</description><Point><coordinates>139.7712317,35.666553,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Zauo Shibuya</name><description>Catch-your-own-fish restaurant. Reserve ahead for evenings. Space apart from Tsukiji.</description><Point><coordinates>139.6998545,35.6624737,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Yakiniku Coco Nemaru Ginza</name><description>Wagyu yakiniku (grill at table). Ask for a private room. 1 min from Ginza Stn Exit C3.</description><Point><coordinates>139.7612311,35.6717064,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Katsudon-ya Zuicho</name><description>One-dish katsudon spot, ~8 seats, expect a line. Closed Sundays.</description><Point><coordinates>139.6953601,35.662703,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Omoide Yokocho (Memory Lane)</name><description>Yakitori alley by Shinjuku Stn. Already on the itinerary (Tokyo #11).</description><Point><coordinates>139.6995778,35.692703699999996,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>The SG Club</name><description>Top cocktail bar, Shibuya. Opens 6 PM. Nightcap spot.</description><Point><coordinates>139.69923140000003,35.6642434,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Sushi Punch</name><description>Omakase sushi, Azabujuban 7F. Book ahead. Closed Sundays.</description><Point><coordinates>139.7357535,35.653654599999996,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Yoroniku Ebisu</name><description>Wagyu yakiniku omakase. Reservation-only, book ~1 month out. Overlaps w/ Coco Nemaru — pick one.</description><Point><coordinates>139.71180569999999,35.646357099999996,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Uonami Fish Bar</name><description>Retro izakaya, Toshima. Out of the way + seafood overlap — low priority. Closed Mondays.</description><Point><coordinates>139.6952222,35.726608899999995,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Good Wood Terrace</name><description>Caribbean jerk chicken, Shibuya (viral after Kanye). Novelty pick. 2-19-3 Dogenzaka.</description><Point><coordinates>139.6935,35.6578,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Tokyo — Shopping</name>
<Placemark><styleUrl>#idea</styleUrl><name>MixTHINKS Harajuku</name><description>Vintage designer bags. Ask condition grade (N/S/A/AB/B). Bring passport for tax-free.</description><Point><coordinates>139.7038071,35.6671291,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Momotaro Jeans Aoyama</name><description>Japanese selvedge denim. Free hemming; can be a wait. Ask about shrinkage.</description><Point><coordinates>139.71055719999998,35.663737000000005,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Nishikawa Sleep Navi — Matsuya Ginza</name><description>Custom-fit pillow. Walk-ins OK; ~20-30 min fitting + ~40 min make. Gift idea for mom.</description><Point><coordinates>139.7667615,35.6723299,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Nishikawa — Nihonbashi (alt)</name><description>Alt custom pillow location. Reservations available online.</description><Point><coordinates>139.7748403,35.6823657,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Kyoto</name>
<Placemark><styleUrl>#idea</styleUrl><name>Sagano Romantic Train — Saga Torokko Stn</name><description>Peak fall leaves late Nov. Book exactly 1 month out; Car No. 5 open-air; right side (AB seats). Pair w/ Arashiyama.</description><Point><coordinates>135.6807823,35.018568,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Taiga Takahashi (T.T)</name><description>Vintage-inspired workwear in a Gion machiya. 12-7 PM daily.</description><Point><coordinates>135.7743322,35.0019692,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>KUOE Kyoto (optional)</name><description>Build-your-own watch. Optional — B.B. Garage is the priority watch stop. Closed Tue.</description><Point><coordinates>135.76682,35.00851,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>Osaka</name>
<Placemark><styleUrl>#idea</styleUrl><name>B.B. Garage (Amerikamura)</name><description>Vintage watches + Americana. 12-8 PM, closed Wed. Ask about overhaul/warranty + original parts.</description><Point><coordinates>135.4985753,34.6703075,0</coordinates></Point></Placemark>
<Placemark><styleUrl>#idea</styleUrl><name>Sennichimae Doguyasuji</name><description>Kitchenware street — knives (engraving), fake food. 10 AM-6 PM. Go before Amemura opens.</description><Point><coordinates>135.5035063,34.664014099999996,0</coordinates></Point></Placemark>
</Folder>
</Document></kml>