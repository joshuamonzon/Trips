<Style id="stop"><IconStyle><color>ffb55824</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/blu-blank.png</href></Icon></IconStyle><LabelStyle><scale>0.9</scale></LabelStyle></Style>
<Style id="transit"><IconStyle><color>ff8a8a8a</color><scale>1.1</scale><Icon><href>https://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle><LabelStyle><scale>0.9</scale></LabelStyle></Style>
<Style id="route"><LineStyle><color>b31b36c4</color><width>3</width></LineStyle></Style>
<Folder><name>01 Tokyo · Nov 28 – Dec 2</name><open>1</open>
<Placemark><name>🏨 Hotel Gracery Shinjuku</name><styleUrl>#sleep</styleUrl><description><![CDATA[<b>Sleep · 4 nights</b><br/>Godzilla on the roof. Narita Express stops at Shinjuku. Alt: Shibuya Stream Excel.<br/><a href='https://www.google.com/maps/search/?api=1&query=Hotel+Gracery+Shinjuku&query_place_id=ChIJF-U1JdiMGGARaay7KIrrtZ0'>Open in Google Maps</a>]]></description><Point><coordinates>139.702034,35.695358,0</coordinates></Point></Placemark>
<Placemark><name>Narita Airport (NRT)</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Sat Nov 28 · 4:30pm</b><br/>Land. Immigration by 5:30. Buy N&#x27;EX tickets at the counter after customs.<br/><a href='https://www.google.com/maps/search/?api=1&query=Narita+Airport+(NRT)'>Open in Google Maps</a>]]></description><Point><coordinates>140.386400,35.764700,0</coordinates></Point></Placemark>
<Placemark><name>2. Shibuya Scramble Crossing</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Nov 28 · evening</b><br/>Stand in the middle of it, then watch from above.<br/>≈ 15 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.659482,139.700560&travelmode=transit'>Directions</a><br/>≈ 15 min by train from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.659482,139.700560&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Shibuya+Scramble+Crossing&query_place_id=ChIJK9EM68qLGGARacmu4KJj5SA'>Open in Google Maps</a>]]></description><Point><coordinates>139.700560,35.659482,0</coordinates></Point></Placemark>
<Placemark><name>3. Senso-ji</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 6:30am</b><br/>Tokyo&#x27;s oldest temple at dawn, 30 min, then Nakamise street. By 10am it&#x27;s a mob.<br/>≈ 35 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.714765,139.796655&travelmode=transit'>Directions</a><br/>≈ 35 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.714765,139.796655&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Senso-ji&query_place_id=ChIJ8T1GpMGOGGARDYGSgpooDWw'>Open in Google Maps</a>]]></description><Point><coordinates>139.796655,35.714765,0</coordinates></Point></Placemark>
<Placemark><name>4. Kappabashi Kitchen Town</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 8am</b><br/>Knives engraved with your name. Buy now, forward home in the suitcase.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.714765,139.796655&destination=35.710580,139.787964&travelmode=walking'>Directions</a><br/>≈ 35 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.710580,139.787964&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kappabashi+Kitchen+Town&query_place_id=ChIJXYV-6JWOGGAR85vIZbM1RCE'>Open in Google Maps</a>]]></description><Point><coordinates>139.787964,35.710580,0</coordinates></Point></Placemark>
<Placemark><name>5. Tsukiji Outer Market</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 10am</b><br/>Tsukiji food tour with Ali (ex-Milos seafood chef), 10–noon. Meet at the Shinran Shonin statue. Food not included: bring cash. airbnb.com/experiences/6919404<br/>≈ 20 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.710580,139.787964&destination=35.664770,139.770252&travelmode=transit'>Directions</a><br/>≈ 30 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.664770,139.770252&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Tsukiji+Outer+Market&query_place_id=ChIJW2cLzSGLGGARXAKXv6EkbqI'>Open in Google Maps</a>]]></description><Point><coordinates>139.770252,35.664770,0</coordinates></Point></Placemark>
<Placemark><name>6. Nishikawa custom pillow (Matsuya Ginza)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 12:30pm</b><br/>Custom-fit pillow at Nishikawa, Matsuya 7F. Walk-in OK: ~30 min fitting, ~40 min to make, so shop Ginza while it&#x27;s built.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.664770,139.770252&destination=35.672330,139.766762&travelmode=walking'>Directions</a><br/>≈ 30 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.672330,139.766762&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Nishikawa+custom+pillow+(Matsuya+Ginza)&query_place_id=ChIJG8GsGImLGGAR1PfGCC2k-ok'>Open in Google Maps</a>]]></description><Point><coordinates>139.766762,35.672330,0</coordinates></Point></Placemark>
<Placemark><name>7. Ginza (Uniqlo flagship)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 1:15pm</b><br/>12-floor Uniqlo, Itoya, depachika food halls. Pick up the pillows on the way out. Passports out for tax-free.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.672330,139.766762&destination=35.670245,139.763469&travelmode=walking'>Directions</a><br/>≈ 30 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.670245,139.763469&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Ginza+(Uniqlo+flagship)&query_place_id=ChIJb9MHbuaLGGAR0xi-noU25UU'>Open in Google Maps</a>]]></description><Point><coordinates>139.763469,35.670245,0</coordinates></Point></Placemark>
<Placemark><name>8. teamLab Planets</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 3pm</b><br/>Timed slot. Barefoot, knee-deep in projected koi. Book 3 weeks out.<br/>≈ 15 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.670245,139.763469&destination=35.649121,139.789774&travelmode=transit'>Directions</a><br/>≈ 40 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.649121,139.789774&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=teamLab+Planets&query_place_id=ChIJSeco5wiJGGARItbTS8lQ5G0'>Open in Google Maps</a>]]></description><Point><coordinates>139.789774,35.649121,0</coordinates></Point></Placemark>
<Placemark><name>9. Zauo Shibuya</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Nov 29 · 5:45pm</b><br/>Early dinner: fish your own from the boat, they cook it how you want. Reserve. Done by 7:30.<br/>≈ 40 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.649121,139.789774&destination=35.662474,139.699854&travelmode=transit'>Directions</a><br/>≈ 20 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.662474,139.699854&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Zauo+Shibuya&query_place_id=ChIJa3cs7aiMGGAR8weY287qaJE'>Open in Google Maps</a>]]></description><Point><coordinates>139.699854,35.662474,0</coordinates></Point></Placemark>
<Placemark><name>10. Solakzade (vintage eyewear)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 10:30am</b><br/>Start in Harajuku back streets (Cat Street). Dad&#x27;s stop: frames from the 1800s–1980s, fitted like a tailor.<br/>≈ 15 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.668301,139.706347&travelmode=transit'>Directions</a><br/>≈ 15 min by train from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.668301,139.706347&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Solakzade+(vintage+eyewear)&query_place_id=ChIJ07gjeKSMGGARXVe4hKptEMA'>Open in Google Maps</a>]]></description><Point><coordinates>139.706347,35.668301,0</coordinates></Point></Placemark>
<Placemark><name>11. MixTHINKS Harajuku (vintage designer bags)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 11:30am</b><br/>Vintage designer bags. Ask the condition grade (N/S/A/AB). Passports for tax-free.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.668301,139.706347&destination=35.667129,139.703807&travelmode=walking'>Directions</a><br/>≈ 20 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.667129,139.703807&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=MixTHINKS+Harajuku+(vintage+designer+bags)&query_place_id=ChIJd5DukxmNGGAR0dK6sam4DIs'>Open in Google Maps</a>]]></description><Point><coordinates>139.703807,35.667129,0</coordinates></Point></Placemark>
<Placemark><name>12. Momotaro Jeans Aoyama</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 12:30pm</b><br/>Japanese selvedge denim. Free hemming while you eat (~1 hr). Omotesando on the way.<br/>≈ 12 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.667129,139.703807&destination=35.663737,139.710557&travelmode=walking'>Directions</a><br/>≈ 20 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.663737,139.710557&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Momotaro+Jeans+Aoyama&query_place_id=ChIJLcQt9l-LGGAR0dWhLQOnX-Y'>Open in Google Maps</a>]]></description><Point><coordinates>139.710557,35.663737,0</coordinates></Point></Placemark>
<Placemark><name>13. Katsudon-ya Zuicho</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 1:45pm</b><br/>Katsudon lunch, one dish, 8 seats, short line. Then back to Momotaro for the hemmed jeans.<br/>≈ 20 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.663737,139.710557&destination=35.662703,139.695360&travelmode=transit'>Directions</a><br/>≈ 20 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.662703,139.695360&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Katsudon-ya+Zuicho&query_place_id=ChIJCZkGEqyMGGAR72gGFgeNxEE'>Open in Google Maps</a>]]></description><Point><coordinates>139.695360,35.662703,0</coordinates></Point></Placemark>
<Placemark><name>14. Shimokitazawa (vintage town)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 3:30pm</b><br/>Shimokitazawa: a whole neighborhood of vintage shops, record stores and cafés. Two hours on foot.<br/>≈ 20 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.662703,139.695360&destination=35.660272,139.667263&travelmode=transit'>Directions</a><br/>≈ 25 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.660272,139.667263&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Shimokitazawa+(vintage+town)&query_place_id=ChIJ3dW4JQDzGGARRqcRBSeCqv0'>Open in Google Maps</a>]]></description><Point><coordinates>139.667263,35.660272,0</coordinates></Point></Placemark>
<Placemark><name>15. Omoide Yokocho</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 7pm</b><br/>Yakitori under the train tracks.<br/>≈ 20 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.660272,139.667263&destination=35.692704,139.699578&travelmode=transit'>Directions</a><br/>≈ 7 min by walk from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.692704,139.699578&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Omoide+Yokocho&query_place_id=ChIJP9eKBdeMGGAR0zzBXJNVj5A'>Open in Google Maps</a>]]></description><Point><coordinates>139.699578,35.692704,0</coordinates></Point></Placemark>
<Placemark><name>16. Golden Gai</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 8:30pm</b><br/>Six alleys, 200 six-seat bars. ~¥1,000 cover each.<br/>≈ 8 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.692704,139.699578&destination=35.694112,139.704761&travelmode=walking'>Directions</a><br/>≈ 5 min by walk from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.694112,139.704761&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Golden+Gai&query_place_id=ChIJr7mGZdmMGGARjxoMFeHApXE'>Open in Google Maps</a>]]></description><Point><coordinates>139.704761,35.694112,0</coordinates></Point></Placemark>
<Placemark><name>17. Bar Zoetrope</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Nov 30 · 9pm</b><br/>Start the whisky here, then hop.<br/>≈ 8 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.694112,139.704761&destination=35.694500,139.698463&travelmode=walking'>Directions</a><br/>≈ 6 min by walk from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.694500,139.698463&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Bar+Zoetrope&query_place_id=ChIJA9cRNtaMGGARrZO3HTmHkXs'>Open in Google Maps</a>]]></description><Point><coordinates>139.698463,35.694500,0</coordinates></Point></Placemark>
<Placemark><name>Shinjuku Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Tue Dec 1 · 7:15am</b><br/>Fuji Excursion train, 7:30 departure. Right side faces the mountain.<br/>≈ 8 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.689607,139.700571&travelmode=walking'>Directions</a><br/>≈ 8 min by walk from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.689607,139.700571&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Shinjuku+Station&query_place_id=ChIJH7qx1tCMGGAR1f2s7PGhMhw'>Open in Google Maps</a>]]></description><Point><coordinates>139.700571,35.689607,0</coordinates></Point></Placemark>
<Placemark><name>Kawaguchiko Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Tue Dec 1 · 9:20am</b><br/>Arrive lakeside.<br/>≈ 1h50 by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.689607,139.700571&destination=35.498236,138.768841&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kawaguchiko+Station&query_place_id=ChIJV3dIuoJgGWAR7bQ0vq8DlE0'>Open in Google Maps</a>]]></description><Point><coordinates>138.768841,35.498236,0</coordinates></Point></Placemark>
<Placemark><name>20. Mt. Tenjo / Fuji Panoramic Ropeway</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Tue Dec 1 · 10am</b><br/>An hour of real climbing to a viewpoint where Fuji fills the horizon. Ropeway down.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.498236,138.768841&destination=35.503802,138.774378&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Mt.+Tenjo+/+Fuji+Panoramic+Ropeway&query_place_id=ChIJMZmgjCZeGWAR6wB5-jDP5Tk'>Open in Google Maps</a>]]></description><Point><coordinates>138.774378,35.503802,0</coordinates></Point></Placemark>
<Placemark><name>21. Hoto Fudo</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Tue Dec 1 · 12:30pm</b><br/>Hoto: fat-noodle miso stew.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.503802,138.774378&destination=35.498861,138.768655&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Hoto+Fudo&query_place_id=ChIJD9e0oIJgGWARjCiXDS-GJmA'>Open in Google Maps</a>]]></description><Point><coordinates>138.768655,35.498861,0</coordinates></Point></Placemark>
<Placemark><name>22. Oishi Park</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Tue Dec 1 · 2pm</b><br/>Lakeshore reflection shot.<br/>≈ 25 min by bus from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.498861,138.768655&destination=35.522904,138.745752&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Oishi+Park&query_place_id=ChIJlSsLjKZfGWARBCllOgtTLqI'>Open in Google Maps</a>]]></description><Point><coordinates>138.745752,35.522904,0</coordinates></Point></Placemark>
<Placemark><name>23. Kyubey Ginza</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Tue Dec 1 · 7:30pm</b><br/>Omakase at the classic counter, since 1935. Pack tonight: big bags to the front desk in the morning.<br/>≈ 20 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.689607,139.700571&destination=35.668468,139.761270&travelmode=transit'>Directions</a><br/>≈ 30 min by metro from Gracery · <a href='https://www.google.com/maps/dir/?api=1&origin=35.695358,139.702034&destination=35.668468,139.761270&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kyubey+Ginza&query_place_id=ChIJu3eG8uiLGGAR14kVvD_YrHI'>Open in Google Maps</a>]]></description><Point><coordinates>139.761270,35.668468,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>02 Kanazawa · Dec 2 – 4</name><open>1</open>
<Placemark><name>🏨 Hotel Intergate Kanazawa</name><styleUrl>#sleep</styleUrl><description><![CDATA[<b>Sleep · 2 nights</b><br/>Night 1 here: free evening drinks, great breakfast, 15 min from the station. Night 2 at Motoyu Ishiya, a 200-year-old onsen ryokan 25 min out of town (kaiseki dinner + breakfast, iron-red spring water). Big bags forwarded Tokyo → Kyoto.<br/><a href='https://www.google.com/maps/search/?api=1&query=Hotel+Intergate+Kanazawa&query_place_id=ChIJ7UkqBf0z-F8Rf332F5I3XzM'>Open in Google Maps</a>]]></description><Point><coordinates>136.653586,36.568240,0</coordinates></Point></Placemark>
<Placemark><name>Tokyo Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Wed Dec 2 · 7:45am</b><br/>Hokuriku Shinkansen direct, 8am. Left side for the mountains.<br/><a href='https://www.google.com/maps/search/?api=1&query=Tokyo+Station&query_place_id=ChIJC3Cf2PuLGGAROO00ukl8JwA'>Open in Google Maps</a>]]></description><Point><coordinates>139.767066,35.681300,0</coordinates></Point></Placemark>
<Placemark><name>Kanazawa Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Wed Dec 2 · 10:30am</b><br/>In by 10:30.<br/>≈ 2h30 by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.681300,139.767066&destination=36.578044,136.648171&travelmode=transit'>Directions</a><br/>≈ 21 min by walk from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.578044,136.648171&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kanazawa+Station&query_place_id=ChIJBYa7A0Iz-F8R6qe7HgH2XV0'>Open in Google Maps</a>]]></description><Point><coordinates>136.648171,36.578044,0</coordinates></Point></Placemark>
<Placemark><name>3. Omicho Market</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 2 · 11:30am</b><br/>Counter lunch: peak snow crab, uni, sweet shrimp.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.571734,136.655865&travelmode=walking'>Directions</a><br/>≈ 10 min by walk from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.571734,136.655865&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Omicho+Market&query_place_id=ChIJ0xPT93Az-F8RpTSlbHwo9L8'>Open in Google Maps</a>]]></description><Point><coordinates>136.655865,36.571734,0</coordinates></Point></Placemark>
<Placemark><name>4. Higashi Chaya District</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 2 · 1pm</b><br/>1820s teahouse district. Gild chopsticks, eat gold-leaf ice cream. Two hours of lanes and shops.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.571734,136.655865&destination=36.572583,136.666560&travelmode=walking'>Directions</a><br/>≈ 23 min by walk from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.572583,136.666560&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Higashi+Chaya+District&query_place_id=ChIJsfC6oXQz-F8RdA1qXiF6jLs'>Open in Google Maps</a>]]></description><Point><coordinates>136.666560,36.572583,0</coordinates></Point></Placemark>
<Placemark><name>5. Nagamachi Samurai District</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 2 · 3:30pm</b><br/>Earthen walls, narrow lanes.<br/>≈ 20 min by bus from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.572583,136.666560&destination=36.563752,136.651015&travelmode=transit'>Directions</a><br/>≈ 10 min by walk from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.563752,136.651015&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Nagamachi+Samurai+District&query_place_id=ChIJhycOJtYz-F8RO54LaTG6_p0'>Open in Google Maps</a>]]></description><Point><coordinates>136.651015,36.563752,0</coordinates></Point></Placemark>
<Placemark><name>6. Nomura-ke Samurai House</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 2 · 4pm</b><br/>Real samurai residence: armor, tea room, tiny garden. 45 min, not a museum day.<br/>≈ 3 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.563752,136.651015&destination=36.564206,136.650032&travelmode=walking'>Directions</a><br/>≈ 10 min by walk from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.564206,136.650032&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Nomura-ke+Samurai+House&query_place_id=ChIJF_AqPH4z-F8Rmtm1IKiShVQ'>Open in Google Maps</a>]]></description><Point><coordinates>136.650032,36.564206,0</coordinates></Point></Placemark>
<Placemark><name>7. Fukumitsuya Sake Brewery</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 2 · 6pm</b><br/>Nodoguro dinner nearby, then a sake flight at the 400-year-old brewery.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.564206,136.650032&destination=36.553705,136.672340&travelmode=walking'>Directions</a><br/>≈ 15 min by metro from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.553705,136.672340&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Fukumitsuya+Sake+Brewery&query_place_id=ChIJp8mGw4oz-F8RG6DuHOB1z6Y'>Open in Google Maps</a>]]></description><Point><coordinates>136.672340,36.553705,0</coordinates></Point></Placemark>
<Placemark><name>Shirakawa-go Bus Terminal</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Thu Dec 3 · 9:25am</b><br/>Bus drops you at the village gate. Everything walkable.<br/>≈ 1h15 by bus from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.578044,136.648171&destination=36.261946,136.906885&travelmode=transit'>Directions</a><br/>≈ 1h25 by train from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.261946,136.906885&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Shirakawa-go+Bus+Terminal&query_place_id=ChIJKx0Jc79x-F8RdUi6Khf_-Is'>Open in Google Maps</a>]]></description><Point><coordinates>136.906885,36.261946,0</coordinates></Point></Placemark>
<Placemark><name>9. Shiroyama Viewpoint</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Thu Dec 3 · 10am</b><br/>The postcard view of 250-year-old gassho farmhouses.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.261946,136.906885&destination=36.263003,136.908558&travelmode=walking'>Directions</a><br/>≈ 1h25 by train from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.263003,136.908558&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Shiroyama+Viewpoint&query_place_id=ChIJ4xHe8r9x-F8RybxsbX5Rr-o'>Open in Google Maps</a>]]></description><Point><coordinates>136.908558,36.263003,0</coordinates></Point></Placemark>
<Placemark><name>10. Wada House</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Thu Dec 3 · 11am</b><br/>Go inside. Hida beef for lunch nearby, then wander the lanes.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.263003,136.908558&destination=36.259905,136.907635&travelmode=walking'>Directions</a><br/>≈ 1h25 by train from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.259905,136.907635&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Wada+House&query_place_id=ChIJdRv_s75x-F8R94Uw560g-iM'>Open in Google Maps</a>]]></description><Point><coordinates>136.907635,36.259905,0</coordinates></Point></Placemark>
<Placemark><name>11. Motoyu Ishiya (Fukatani Onsen)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Thu Dec 3 · 3pm</b><br/>Check in. Yukata, the big outdoor bath, then a multi-course crab kaiseki in the room. Early night.<br/>≈ 25 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.578044,136.648171&destination=36.613703,136.720958&travelmode=transit'>Directions</a><br/>≈ 35 min by metro from Intergate · <a href='https://www.google.com/maps/dir/?api=1&origin=36.568240,136.653586&destination=36.613703,136.720958&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Motoyu+Ishiya+(Fukatani+Onsen)&query_place_id=ChIJYRXlBUMt-F8RB_F70Zzyx74'>Open in Google Maps</a>]]></description><Point><coordinates>136.720958,36.613703,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>03 Kyoto · Dec 4 – 9</name><open>1</open>
<Placemark><name>🏨 Hotel Resol Kyoto Kawaramachi Sanjo</name><styleUrl>#sleep</styleUrl><description><![CDATA[<b>Sleep · 5 nights</b><br/>Central, public bath, Nishiki Market 2 min, Teramachi arcades 1 min, Pontocho out the back. Gion is a 10-min walk. Bags forwarded from Tokyo are waiting here.<br/><a href='https://www.google.com/maps/search/?api=1&query=Hotel+Resol+Kyoto+Kawaramachi+Sanjo&query_place_id=ChIJq2kbb5MIAWARPjnryqGzDrg'>Open in Google Maps</a>]]></description><Point><coordinates>135.769220,35.007950,0</coordinates></Point></Placemark>
<Placemark><name>Kanazawa Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Fri Dec 4 · 9:45am</b><br/>Ryokan taxi/shuttle to the station. 10:15 Thunderbird express along Lake Biwa.<br/><a href='https://www.google.com/maps/search/?api=1&query=Kanazawa+Station&query_place_id=ChIJBYa7A0Iz-F8R6qe7HgH2XV0'>Open in Google Maps</a>]]></description><Point><coordinates>136.648171,36.578044,0</coordinates></Point></Placemark>
<Placemark><name>Kyoto Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Fri Dec 4 · 12:30pm</b><br/>≈ 2h15 by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=36.578044,136.648171&destination=34.985849,135.758767&travelmode=transit'>Directions</a><br/>≈ 20 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.985849,135.758767&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kyoto+Station&query_place_id=ChIJ7wKLka4IAWARCByidG5EGrY'>Open in Google Maps</a>]]></description><Point><coordinates>135.758767,34.985849,0</coordinates></Point></Placemark>
<Placemark><name>3. Nishiki Market</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 4 · 2pm</b><br/>Kyoto&#x27;s kitchen: five blocks of pickles, tofu doughnuts, knives. Graze for lunch.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.005026,135.764723&travelmode=walking'>Directions</a><br/>≈ 5 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.005026,135.764723&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Nishiki+Market&query_place_id=ChIJT8uMzZwIAWARnGzsARCjnrY'>Open in Google Maps</a>]]></description><Point><coordinates>135.764723,35.005026,0</coordinates></Point></Placemark>
<Placemark><name>4. Teramachi + Shinkyogoku arcades</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 4 · 3:30pm</b><br/>Two covered arcades off the market: vintage, kimono, tea, sneakers. The 2nd-oldest arcade in Japan.<br/>≈ 3 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.005026,135.764723&destination=35.007104,135.767156&travelmode=walking'>Directions</a><br/>≈ 4 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.007104,135.767156&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Teramachi+++Shinkyogoku+arcades&query_place_id=ChIJ6fUyMZQIAWAR4tOOD7AkWJw'>Open in Google Maps</a>]]></description><Point><coordinates>135.767156,35.007104,0</coordinates></Point></Placemark>
<Placemark><name>5. KUOE Kyoto (build-your-own watch)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 4 · 4:45pm</b><br/>Build-your-own watch at the Kyoto flagship (closed Tue). 2 min from the hotel.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007104,135.767156&destination=35.008510,135.766820&travelmode=walking'>Directions</a><br/>≈ 4 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.008510,135.766820&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=KUOE+Kyoto+(build-your-own+watch)&query_place_id=ChIJBc57aw4JAWARNRkUdgsACvY'>Open in Google Maps</a>]]></description><Point><coordinates>135.766820,35.008510,0</coordinates></Point></Placemark>
<Placemark><name>6. Samurai Kembu Theater</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 4 · 6:30pm</b><br/>90 min: hakama on, learn to draw and cut, then the performance.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.009537,135.775539&travelmode=walking'>Directions</a><br/>≈ 10 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.009537,135.775539&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Samurai+Kembu+Theater&query_place_id=ChIJXQxzcPgMAWAR2MVdzqV2kkY'>Open in Google Maps</a>]]></description><Point><coordinates>135.775539,35.009537,0</coordinates></Point></Placemark>
<Placemark><name>7. Pontocho Alley</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 4 · 8:30pm</b><br/>Late dinner in the lantern-lit alley along the river.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.009537,135.775539&destination=35.003934,135.771044&travelmode=walking'>Directions</a><br/>≈ 9 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.003934,135.771044&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Pontocho+Alley&query_place_id=ChIJP2DblBgJAWARAgLlF0vWT6o'>Open in Google Maps</a>]]></description><Point><coordinates>135.771044,35.003934,0</coordinates></Point></Placemark>
<Placemark><name>8. Sagano Romantic Train (Saga Torokko Sta)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 5 · 12:15pm</b><br/>Sagano Romantic Train one way through the Hozu gorge in peak fall color. Seats open exactly 1 month out (Nov 5): Car No. 5 (open-air), right side. JR back from Umahori.<br/>≈ 35 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.018568,135.680782&travelmode=transit'>Directions</a><br/>≈ 35 min by train from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.018568,135.680782&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Sagano+Romantic+Train+(Saga+Torokko+Sta)&query_place_id=ChIJh2v-m_6pAWAR9TR4D4O6S24'>Open in Google Maps</a>]]></description><Point><coordinates>135.680782,35.018568,0</coordinates></Point></Placemark>
<Placemark><name>9. Arashiyama Bamboo Grove</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 5 · 1:45pm</b><br/>60-ft stalks creaking in the wind. 20 min, then the shop street and the river bridge.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.018568,135.680782&destination=35.016819,135.671301&travelmode=walking'>Directions</a><br/>≈ 40 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.016819,135.671301&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Arashiyama+Bamboo+Grove&query_place_id=ChIJrYtcv-urAWAR3XzWvXv8n_s'>Open in Google Maps</a>]]></description><Point><coordinates>135.671301,35.016819,0</coordinates></Point></Placemark>
<Placemark><name>10. Tenryu-ji</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 5 · 2:15pm</b><br/>Zen garden, 30 min. Skip the inner buildings.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.016819,135.671301&destination=35.015838,135.673765&travelmode=walking'>Directions</a><br/>≈ 35 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.015838,135.673765&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Tenryu-ji&query_place_id=ChIJk54PuAGqAWARwEgz_9o-nM0'>Open in Google Maps</a>]]></description><Point><coordinates>135.673765,35.015838,0</coordinates></Point></Placemark>
<Placemark><name>11. Okochi Sanso Garden</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 5 · 3pm</b><br/>A silent-film star&#x27;s mountain garden, tea included. 45 min, best view in Arashiyama.<br/>≈ 8 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.015838,135.673765&destination=35.016715,135.669923&travelmode=walking'>Directions</a><br/>≈ 40 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.016715,135.669923&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Okochi+Sanso+Garden&query_place_id=ChIJGTfQ9gSqAWARvzp3lzOgjk8'>Open in Google Maps</a>]]></description><Point><coordinates>135.669923,35.016715,0</coordinates></Point></Placemark>
<Placemark><name>12. Takashimaya Kyoto (Shijo)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 5 · 5:30pm</b><br/>Shijo department-store row: Takashimaya, Daimaru, Fujii Daimaru. Depachika dinner and tax-free on 7F.<br/>≈ 35 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.016715,135.669923&destination=35.003100,135.768496&travelmode=transit'>Directions</a><br/>≈ 10 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.003100,135.768496&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Takashimaya+Kyoto+(Shijo)&query_place_id=ChIJwzqJepUIAWARvlUYqigZpJI'>Open in Google Maps</a>]]></description><Point><coordinates>135.768496,35.003100,0</coordinates></Point></Placemark>
<Placemark><name>13. Bar K6</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 5 · 8:30pm</b><br/>Japanese whisky nightcap.<br/>≈ 12 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.003100,135.768496&destination=35.013320,135.770556&travelmode=walking'>Directions</a><br/>≈ 11 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.013320,135.770556&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Bar+K6&query_place_id=ChIJ2b4ClM0HAWARHNrgkqv5EDI'>Open in Google Maps</a>]]></description><Point><coordinates>135.770556,35.013320,0</coordinates></Point></Placemark>
<Placemark><name>14. Todai-ji (Nara)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 6 · 10am</b><br/>45 min to Nara + a walk through the deer park. Buy deer crackers.<br/>≈ 1h by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.688985,135.839816&travelmode=transit'>Directions</a><br/>≈ 1h by train from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.688985,135.839816&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Todai-ji+(Nara)&query_place_id=ChIJ3XYIepA5AWARjzzVnT-skPg'>Open in Google Maps</a>]]></description><Point><coordinates>135.839816,34.688985,0</coordinates></Point></Placemark>
<Placemark><name>15. Kasuga Taisha (Nara)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 6 · noon</b><br/>Lantern-lined cedar path, 30 min. Lunch on Nara&#x27;s shopping street (Higashimuki) on the way back.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.688985,135.839816&destination=34.681545,135.848472&travelmode=walking'>Directions</a><br/>≈ 1h20 by train from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.681545,135.848472&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kasuga+Taisha+(Nara)&query_place_id=ChIJ1Wqwa8A5AWARlpXjgoPnl0w'>Open in Google Maps</a>]]></description><Point><coordinates>135.848472,34.681545,0</coordinates></Point></Placemark>
<Placemark><name>16. Fushimi Sake Village</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 6 · 2:30pm</b><br/>Willow canal, one counter with 18 breweries.<br/>≈ 45 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.681545,135.848472&destination=34.932500,135.760556&travelmode=transit'>Directions</a><br/>≈ 35 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.932500,135.760556&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Fushimi+Sake+Village&query_place_id=ChIJRwOaco4PAWARzaIhH6-kLG8'>Open in Google Maps</a>]]></description><Point><coordinates>135.760556,34.932500,0</coordinates></Point></Placemark>
<Placemark><name>17. Fushimi Inari Taisha</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 6 · 4pm</b><br/>10,000 gates. Keep going 30 min past where everyone stops. Open all night.<br/>≈ 15 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.932500,135.760556&destination=34.967695,135.779188&travelmode=transit'>Directions</a><br/>≈ 25 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.967695,135.779188&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Fushimi+Inari+Taisha&query_place_id=ChIJIW0uPRUPAWAR6eI6dRzKGns'>Open in Google Maps</a>]]></description><Point><coordinates>135.779188,34.967695,0</coordinates></Point></Placemark>
<Placemark><name>18. Taiga Takahashi (T.T)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 7 · 11am</b><br/>Taiga Takahashi: vintage-inspired workwear in a Gion machiya. Then the Hanamikoji / Shijo Gion shops.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.001969,135.774332&travelmode=walking'>Directions</a><br/>≈ 15 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.001969,135.774332&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Taiga+Takahashi+(T.T)&query_place_id=ChIJSVB1LIIJAWARSqg5sapwPYo'>Open in Google Maps</a>]]></description><Point><coordinates>135.774332,35.001969,0</coordinates></Point></Placemark>
<Placemark><name>19. Gion teahouse (tea ceremony, Hanamikoji)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 7 · 12:30pm</b><br/>Lunch in Gion, then the Yasaka backstreets: Ishibe-koji, Nene-no-michi.<br/>≈ 8 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.001969,135.774332&destination=35.003600,135.775000&travelmode=walking'>Directions</a><br/>≈ 13 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.003600,135.775000&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Gion+teahouse+(tea+ceremony,+Hanamikoji)'>Open in Google Maps</a>]]></description><Point><coordinates>135.775000,35.003600,0</coordinates></Point></Placemark>
<Placemark><name>20. Ninenzaka</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 7 · 2pm</b><br/>Stone lanes up the hill. Rent kimono for the walk if Mom&#x27;s in (shops at the bottom of the hill).<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.003600,135.775000&destination=34.998399,135.780843&travelmode=walking'>Directions</a><br/>≈ 15 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.998399,135.780843&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Ninenzaka&query_place_id=ChIJlwyrGNAIAWARNb5hUHdZruY'>Open in Google Maps</a>]]></description><Point><coordinates>135.780843,34.998399,0</coordinates></Point></Placemark>
<Placemark><name>21. Kiyomizu-dera</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 7 · 3:30pm</b><br/>The temple on wooden stilts at golden hour. 45 min, the view is the point.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.998399,135.780843&destination=34.994666,135.784661&travelmode=walking'>Directions</a><br/>≈ 15 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=34.994666,135.784661&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kiyomizu-dera&query_place_id=ChIJB_vchdMIAWARujTEUIZlr2I'>Open in Google Maps</a>]]></description><Point><coordinates>135.784661,34.994666,0</coordinates></Point></Placemark>
<Placemark><name>22. Hyotei (3-star kaiseki, since 1837)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 7 · 6pm</b><br/>Hyotei: three stars, 1837, kaiseki in a private garden room. Book through the hotel concierge the day you confirm the trip; it needs a Japanese phone line. Alt: Roan Kikunoi (2*), Gion Nishikawa (2*).<br/>≈ 20 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.994666,135.784661&destination=35.011413,135.786762&travelmode=transit'>Directions</a><br/>≈ 15 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.011413,135.786762&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Hyotei+(3-star+kaiseki,+since+1837)&query_place_id=ChIJw5-sbOAIAWAR3IVM2hFyg5A'>Open in Google Maps</a>]]></description><Point><coordinates>135.786762,35.011413,0</coordinates></Point></Placemark>
<Placemark><name>23. Kikunoi Honten</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Tue Dec 8 · Mom turns 50 · 12:30pm</b><br/>Three-star lunch kaiseki at half the dinner price. Two Michelin meals in 24 hours: lunch is the lighter one.<br/>≈ 15 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.005026,135.764723&destination=35.001475,135.782056&travelmode=transit'>Directions</a><br/>≈ 15 min by metro from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.001475,135.782056&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kikunoi+Honten&query_place_id=ChIJVVXF5doIAWARUetIixOU-sw'>Open in Google Maps</a>]]></description><Point><coordinates>135.782056,35.001475,0</coordinates></Point></Placemark>
<Placemark><name>24. Gion Hatanaka (maiko dinner)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Tue Dec 8 · Mom turns 50 · 6:30pm</b><br/>The dinner. Private maiko evening, two hours, cake requested. Fill out Korea&#x27;s e-Arrival Card tonight.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.003934,135.771044&destination=35.002315,135.778935&travelmode=walking'>Directions</a><br/>≈ 20 min by walk from Hotel Resol · <a href='https://www.google.com/maps/dir/?api=1&origin=35.007950,135.769220&destination=35.002315,135.778935&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Gion+Hatanaka+(maiko+dinner)&query_place_id=ChIJqWdMmsQIAWAR9LzT5fDOD7c'>Open in Google Maps</a>]]></description><Point><coordinates>135.778935,35.002315,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>04 Osaka · Dec 9 – 11</name><open>1</open>
<Placemark><name>🏨 Cross Hotel Osaka</name><styleUrl>#sleep</styleUrl><description><![CDATA[<b>Sleep · 2 nights</b><br/>One block from Dotonbori; Amerikamura and Shinsaibashi are a 5-min walk. Alt: Hotel Royal Classic (kabuki-theater building, on Namba Station). Big suitcases forwarded to the Dec 13 Tokyo hotel on the morning of the 11th.<br/><a href='https://www.google.com/maps/search/?api=1&query=Cross+Hotel+Osaka&query_place_id=ChIJA0zO7hPnAGARHooEfgZ_MsY'>Open in Google Maps</a>]]></description><Point><coordinates>135.500763,34.669715,0</coordinates></Point></Placemark>
<Placemark><name>Kyoto Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Wed Dec 9 · 9:30am</b><br/>Shinkansen, 15 min. Bags come with you.<br/>≈ 10 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.985849,135.758767&travelmode=transit'>Directions</a><br/>≈ 10 min by metro from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.985849,135.758767&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kyoto+Station&query_place_id=ChIJ7wKLka4IAWARCByidG5EGrY'>Open in Google Maps</a>]]></description><Point><coordinates>135.758767,34.985849,0</coordinates></Point></Placemark>
<Placemark><name>2. Kuromon Market</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 9 · 11am</b><br/>Kuromon Market: grilled king crab legs, otoro, wagyu skewers, standing up.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.665351,135.506242&travelmode=walking'>Directions</a><br/>≈ 10 min by walk from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.665351,135.506242&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kuromon+Market&query_place_id=ChIJXSJB5UHnAGARQcEjvngsHaw'>Open in Google Maps</a>]]></description><Point><coordinates>135.506242,34.665351,0</coordinates></Point></Placemark>
<Placemark><name>3. Sennichimae Doguyasuji (kitchen street)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 9 · 12:30pm</b><br/>150 m of pro kitchen shops: knives, takoyaki pans, the plastic display food. Closes 6pm.<br/>≈ 5 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.665351,135.506242&destination=34.664014,135.503506&travelmode=walking'>Directions</a><br/>≈ 12 min by walk from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.664014,135.503506&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Sennichimae+Doguyasuji+(kitchen+street)&query_place_id=ChIJfQfezmvnAGARy4Sd3VGFy_A'>Open in Google Maps</a>]]></description><Point><coordinates>135.503506,34.664014,0</coordinates></Point></Placemark>
<Placemark><name>4. Shinsaibashi-suji arcade</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 9 · 2pm</b><br/>600 m covered arcade: Uniqlo, drugstores, the giant Don Quijote. Tax-free with passport.<br/>≈ 12 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.664014,135.503506&destination=34.672509,135.501366&travelmode=walking'>Directions</a><br/>≈ 6 min by walk from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.672509,135.501366&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Shinsaibashi-suji+arcade&query_place_id=ChIJc7M3_BPnAGARI8OZlTnEXGI'>Open in Google Maps</a>]]></description><Point><coordinates>135.501366,34.672509,0</coordinates></Point></Placemark>
<Placemark><name>5. B.B. Garage (vintage watches)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 9 · 3:30pm</b><br/>Amerikamura: vintage Americana, and the watch counter at the back. Ask if it&#x27;s been overhauled and if the dial/hands are original. Open till 8, closed Wed → this is Wednesday: swap to Thursday if they&#x27;re closed (see Dec 10).<br/>≈ 8 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.672509,135.501366&destination=34.670307,135.498575&travelmode=walking'>Directions</a><br/>≈ 4 min by walk from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.670307,135.498575&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=B.B.+Garage+(vintage+watches)&query_place_id=ChIJ62Sj0EznAGARLILmS20T5LM'>Open in Google Maps</a>]]></description><Point><coordinates>135.498575,34.670307,0</coordinates></Point></Placemark>
<Placemark><name>6. Dotonbori</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Wed Dec 9 · 6pm</b><br/>The canal, the Glico man, kushikatsu and takoyaki standing up.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.670307,135.498575&destination=34.668647,135.503098&travelmode=walking'>Directions</a><br/>≈ 4 min by walk from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.668647,135.503098&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Dotonbori&query_place_id=ChIJg2DcJhXnAGARCbeAHoZrPeQ'>Open in Google Maps</a>]]></description><Point><coordinates>135.503098,34.668647,0</coordinates></Point></Placemark>
<Placemark><name>7. Suntory Yamazaki Distillery</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Thu Dec 10 · 10am</b><br/>Where Japanese whisky was born. Tour is a lottery 2 months out; tasting counter takes a reservation.<br/>≈ 35 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.892457,135.674451&travelmode=transit'>Directions</a><br/>≈ 35 min by train from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.892457,135.674451&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Suntory+Yamazaki+Distillery&query_place_id=ChIJ-WxR9WMDAWARHW0W4OC39qE'>Open in Google Maps</a>]]></description><Point><coordinates>135.674451,34.892457,0</coordinates></Point></Placemark>
<Placemark><name>8. Grand Front Osaka (Umeda)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Thu Dec 10 · 1pm</b><br/>Umeda: Grand Front, Hankyu, the underground mall maze. Lunch on the top-floor restaurant terrace.<br/>≈ 30 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.892457,135.674451&destination=34.703916,135.494010&travelmode=transit'>Directions</a><br/>≈ 20 min by metro from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.703916,135.494010&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Grand+Front+Osaka+(Umeda)&query_place_id=ChIJAQAAB4_mAGAR1alcFGtOaAo'>Open in Google Maps</a>]]></description><Point><coordinates>135.494010,34.703916,0</coordinates></Point></Placemark>
<Placemark><name>9. Tsutenkaku / Shinsekai</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Thu Dec 10 · 6pm</b><br/>Shinsekai: the 1912 tower, kushikatsu counters, Showa-era signs. Go up for the night view. Early night: 7am airport train.<br/>≈ 15 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.670307,135.498575&destination=34.652499,135.506306&travelmode=transit'>Directions</a><br/>≈ 15 min by metro from Cross Hotel · <a href='https://www.google.com/maps/dir/?api=1&origin=34.669715,135.500763&destination=34.652499,135.506306&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Tsutenkaku+/+Shinsekai&query_place_id=ChIJ_0Lgd2DnAGARV0X03lbPy-U'>Open in Google Maps</a>]]></description><Point><coordinates>135.506306,34.652499,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>05 Seoul · Dec 11 – 13</name><open>1</open>
<Placemark><name>🏨 Andaz Seoul Gangnam</name><styleUrl>#sleep</styleUrl><description><![CDATA[<b>Sleep · 2 nights</b><br/>Gangnam, where every clinic is. Pool, sauna, hot tub on site for contrast bathing. Direct subway access from B2. Alt: Nine Tree Insadong (north side). Use Naver Map or KakaoMap here; Google Maps can&#x27;t route in Korea.<br/><a href='https://www.google.com/maps/search/?api=1&query=Andaz+Seoul+Gangnam&query_place_id=ChIJix_5SI6jfDURODDRE4Ama2M'>Open in Google Maps</a>]]></description><Point><coordinates>127.028920,37.525488,0</coordinates></Point></Placemark>
<Placemark><name>Namba Station (airport express)</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Fri Dec 11 · 6:50am</b><br/>7am airport express (45 min).<br/><a href='https://www.google.com/maps/search/?api=1&query=Namba+Station+(airport+express)'>Open in Google Maps</a>]]></description><Point><coordinates>135.502100,34.662700,0</coordinates></Point></Placemark>
<Placemark><name>Kansai International Airport (KIX)</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Fri Dec 11 · 7:45am</b><br/>Morning flight to Incheon, 2h.<br/>≈ 45 min by train from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.662700,135.502100&destination=34.431999,135.236602&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Kansai+International+Airport+(KIX)&query_place_id=ChIJ9_rNIxO5AGARiI-QjZ-ncfE'>Open in Google Maps</a>]]></description><Point><coordinates>135.236602,34.431999,0</coordinates></Point></Placemark>
<Placemark><name>Incheon International Airport (ICN)</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Fri Dec 11 · 11am</b><br/>Through immigration by noon with the e-Arrival Card. AREX + subway to Gangnam.<br/>≈ 2h by flight from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=34.431999,135.236602&destination=37.458666,126.441968&travelmode=transit'>Directions</a><br/>≈ 1h45 by train from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.458666,126.441968&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Incheon+International+Airport+(ICN)&query_place_id=ChIJWfpeOoOaezUR1L5cy5agS40'>Open in Google Maps</a>]]></description><Point><coordinates>126.441968,37.458666,0</coordinates></Point></Placemark>
<Placemark><name>4. AGJ Hana Clinic (NAD+ / glutathione IV)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 11 · 2pm</b><br/>Doctor-led longevity consult + NAD+ or glutathione IV for the jet lag. ~90 min. English, WhatsApp bookings.<br/>≈ 10 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.528293,127.037446&travelmode=transit'>Directions</a><br/>≈ 10 min by taxi from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.528293,127.037446&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=AGJ+Hana+Clinic+(NAD++/+glutathione+IV)&query_place_id=ChIJF-_ROQCjfDUR5Miy1Yc2Uq4'>Open in Google Maps</a>]]></description><Point><coordinates>127.037446,37.528293,0</coordinates></Point></Placemark>
<Placemark><name>5. O2ON (hyperbaric oxygen)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 11 · 4pm</b><br/>60 min of medical-grade hyperbaric oxygen. Cheapest HBOT in Gangnam, no clinic markup.<br/>≈ 10 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.528293,127.037446&destination=37.520743,127.030209&travelmode=transit'>Directions</a><br/>≈ 10 min by walk from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.520743,127.030209&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=O2ON+(hyperbaric+oxygen)&query_place_id=ChIJu6A69vOjfDURvocQmFQEbFY'>Open in Google Maps</a>]]></description><Point><coordinates>127.030209,37.520743,0</coordinates></Point></Placemark>
<Placemark><name>6. Garosu-gil</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Fri Dec 11 · 5:30pm</b><br/>Tree-lined boutique street, 10 min from the chamber. Olive Young for the K-beauty haul (tax-free with passport).<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.520743,127.030209&destination=37.521057,127.022869&travelmode=walking'>Directions</a><br/>≈ 13 min by walk from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.521057,127.022869&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Garosu-gil&query_place_id=ChIJI_IUbOujfDUReyU3t6AyGoM'>Open in Google Maps</a>]]></description><Point><coordinates>127.022869,37.521057,0</coordinates></Point></Placemark>
<Placemark><name>7. Reberry Clinic Gangnam (skin)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 12 · 9:30am</b><br/>AI skin profiling, then zero-downtime lifting: Thermage FLX / Ultherapy / Potenza, plus an LDM ultrasound for the glass-skin finish. ~3 hrs. Book 2–4 weeks ahead, English staff.<br/>≈ 15 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.501840,127.024645&travelmode=transit'>Directions</a><br/>≈ 15 min by metro from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.501840,127.024645&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Reberry+Clinic+Gangnam+(skin)&query_place_id=ChIJYZZUr5oaO2QRD9IKKBX6Q9U'>Open in Google Maps</a>]]></description><Point><coordinates>127.024645,37.501840,0</coordinates></Point></Placemark>
<Placemark><name>8. Myshopper (personal color)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 12 · 1:30pm</b><br/>16-type personal color analysis, 1 hr. Bring your makeup pouch. You get a palette PDF for the afternoon&#x27;s shopping.<br/>≈ 15 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.501840,127.024645&destination=37.523121,127.032398&travelmode=transit'>Directions</a><br/>≈ 7 min by walk from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.523121,127.032398&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Myshopper+(personal+color)&query_place_id=ChIJr9RmQmajfDURfz0pyNU27u4'>Open in Google Maps</a>]]></description><Point><coordinates>127.032398,37.523121,0</coordinates></Point></Placemark>
<Placemark><name>9. Park Jun Beauty Lab Cheongdam (scalp spa)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 12 · 3pm</b><br/>15-step scalp spa + neck/back massage in a private room, 90 min. Book ahead; it&#x27;s an award-winning med-tourism spot.<br/>≈ 10 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.523121,127.032398&destination=37.518496,127.050210&travelmode=transit'>Directions</a><br/>≈ 15 min by metro from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.518496,127.050210&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Park+Jun+Beauty+Lab+Cheongdam+(scalp+spa)&query_place_id=ChIJsWosT3CkfDURVi3y21bRSUo'>Open in Google Maps</a>]]></description><Point><coordinates>127.050210,37.518496,0</coordinates></Point></Placemark>
<Placemark><name>10. AMORE Seongsu (custom skincare)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sat Dec 12 · 5:30pm</b><br/>Amore Seongsu: AI skin scan and a custom-formulated serum / lipstick. Then Seongsu-dong: warehouses turned cafés, pop-ups, the sneaker shops. Open till 8:30.<br/>≈ 30 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.518496,127.050210&destination=37.544410,127.059120&travelmode=transit'>Directions</a><br/>≈ 20 min by metro from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.544410,127.059120&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=AMORE+Seongsu+(custom+skincare)&query_place_id=ChIJsy6u20mlfDURQOlVT0xmv6U'>Open in Google Maps</a>]]></description><Point><coordinates>127.059120,37.544410,0</coordinates></Point></Placemark>
<Placemark><name>11. Inwangsan trailhead</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 13 · 7:30am</b><br/>Inwangsan: 1.5 hrs up the Seoul fortress wall to the summit at sunrise. Granite, stairs, the whole skyline. Trail shoes.<br/>≈ 35 min by taxi from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.581241,126.954548&travelmode=transit'>Directions</a><br/>≈ 35 min by taxi from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.581241,126.954548&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Inwangsan+trailhead&query_place_id=ChIJwVINcm6jfDURGcu6ZKSQZkY'>Open in Google Maps</a>]]></description><Point><coordinates>126.954548,37.581241,0</coordinates></Point></Placemark>
<Placemark><name>12. Tosokchon Samgyetang</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 13 · 10am</b><br/>Tosokchon samgyetang: whole ginseng chicken soup, the recovery meal. Opens 10, be in line at 9:50.<br/>≈ 15 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.581241,126.954548&destination=37.577779,126.971591&travelmode=walking'>Directions</a><br/>≈ 35 min by metro from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.577779,126.971591&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Tosokchon+Samgyetang&query_place_id=ChIJb5OOGL6ifDURU29ID3t8aOA'>Open in Google Maps</a>]]></description><Point><coordinates>126.971591,37.577779,0</coordinates></Point></Placemark>
<Placemark><name>13. Gyeongbokgung Palace</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 13 · 11am</b><br/>Rent hanbok by the gate (free palace entry). The photo op of the trip. Non-negotiable. One hour, then out.<br/>≈ 10 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=37.577779,126.971591&destination=37.579617,126.977041&travelmode=walking'>Directions</a><br/>≈ 35 min by metro from Andaz · <a href='https://www.google.com/maps/dir/?api=1&origin=37.525488,127.028920&destination=37.579617,126.977041&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Gyeongbokgung+Palace&query_place_id=ChIJod7tSseifDUR9hXHLFNGMIs'>Open in Google Maps</a>]]></description><Point><coordinates>126.977041,37.579617,0</coordinates></Point></Placemark>
</Folder>
<Folder><name>06 Tokyo, last night · Dec 13 – 14</name><open>1</open>
<Placemark><name>🏨 Hotel Metropolitan Tokyo Marunouchi</name><styleUrl>#sleep</styleUrl><description><![CDATA[<b>Sleep · 1 night</b><br/>On top of Tokyo Station, where the Narita Express leaves from. Suitcases forwarded from Osaka are waiting at the desk.<br/><a href='https://www.google.com/maps/search/?api=1&query=Hotel+Metropolitan+Tokyo+Marunouchi&query_place_id=ChIJkwDaxf6LGGARl7WXPY_ic9A'>Open in Google Maps</a>]]></description><Point><coordinates>139.768570,35.683897,0</coordinates></Point></Placemark>
<Placemark><name>Narita Airport (NRT)</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Sun Dec 13 · 4:30pm</b><br/>Land. Narita Express to Tokyo Station, 1 hour.<br/>≈ 2h30 by flight from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.764700,140.386400&travelmode=transit'>Directions</a><br/>≈ 2h30 by flight from Metropolitan · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.764700,140.386400&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Narita+Airport+(NRT)'>Open in Google Maps</a>]]></description><Point><coordinates>140.386400,35.764700,0</coordinates></Point></Placemark>
<Placemark><name>2. Sushi Yuu (Nishiazabu)</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Sun Dec 13 · 8pm</b><br/>The second omakase, a tier up. English-speaking chef. Pack it all tonight.<br/>≈ 25 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.661835,139.725206&travelmode=transit'>Directions</a><br/>≈ 25 min by metro from Metropolitan · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.661835,139.725206&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Sushi+Yuu+(Nishiazabu)&query_place_id=ChIJ13sWRHqLGGARX9fpN_Tkxfc'>Open in Google Maps</a>]]></description><Point><coordinates>139.725206,35.661835,0</coordinates></Point></Placemark>
<Placemark><name>3. Tsukiji Outer Market</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 14 · 8:30am</b><br/>One last market breakfast.<br/>≈ 15 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.664770,139.770252&travelmode=transit'>Directions</a><br/>≈ 15 min by metro from Metropolitan · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.664770,139.770252&travelmode=transit'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Tsukiji+Outer+Market&query_place_id=ChIJW2cLzSGLGGARXAKXv6EkbqI'>Open in Google Maps</a>]]></description><Point><coordinates>139.770252,35.664770,0</coordinates></Point></Placemark>
<Placemark><name>4. Imperial Palace East Garden</name><styleUrl>#stop</styleUrl><description><![CDATA[<b>Mon Dec 14 · 10am</b><br/>Five minutes from the hotel. Check out by noon.<br/>≈ 15 min by metro from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.664770,139.770252&destination=35.686782,139.757145&travelmode=transit'>Directions</a><br/>≈ 19 min by walk from Metropolitan · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.686782,139.757145&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Imperial+Palace+East+Garden&query_place_id=ChIJPfFaQhOMGGAR-QPbNQoAG6M'>Open in Google Maps</a>]]></description><Point><coordinates>139.757145,35.686782,0</coordinates></Point></Placemark>
<Placemark><name>Tokyo Station</name><styleUrl>#transit</styleUrl><description><![CDATA[<b>Mon Dec 14 · 2:30pm</b><br/>2:45 Narita Express.<br/>≈ 3 min by walk from the previous stop · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.681300,139.767066&travelmode=walking'>Directions</a><br/>≈ 3 min by walk from Metropolitan · <a href='https://www.google.com/maps/dir/?api=1&origin=35.683897,139.768570&destination=35.681300,139.767066&travelmode=walking'>Directions</a><br/><a href='https://www.google.com/maps/search/?api=1&query=Tokyo+Station&query_place_id=ChIJC3Cf2PuLGGAROO00ukl8JwA'>Open in Google Maps</a>]]></description><Point><coordinates>139.767066,35.681300,0</coordinates></Point></Placemark>
